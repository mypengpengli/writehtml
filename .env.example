# ===================================================================
# .env.example  ——  仅本地开发参考，生产部署【不需要】这个文件
# -------------------------------------------------------------------
# 服务器部署用 docker-compose.yml，里面已配好环境变量，无需 .env。
# 每位用户登录后在右上角 ⚙ 设置里填自己的 base_url / api_key / 模型ID；
# 仅关闭语音直发时才需要配置独立的语音转写服务。
# 服务器无需共享模型密钥；注册策略由 compose 中的 SIGNUP_CODE 控制。
#
# 仅当你在本机直接 `python main.py` 调试时，才把本文件复制为 .env 使用。
# ===================================================================

# ---- 数据库 ----
# SQLite 文件路径。容器内固定为 /data/writehtml.db（由 compose 挂载 ./data:/data）
DB_PATH=./data/writehtml.db

# ---- 灵感库原始素材 ----
# 默认与数据库放在同一持久目录。生产环境请连同整个 data 目录一起备份。
INSPIRATION_STORAGE_DIR=./data/inspirations
INSPIRATION_IMAGE_MAX_BYTES=20971520
INSPIRATION_AUDIO_MAX_BYTES=104857600
INSPIRATION_VIDEO_MAX_BYTES=314572800
# 每个用户去重后的原始素材总量，默认 5GB；设为 0 表示不限制。
INSPIRATION_USER_STORAGE_LIMIT_BYTES=5368709120
INSPIRATION_WORKER_ENABLED=true
INSPIRATION_WORKER_POLL_SECONDS=1.5
INSPIRATION_TEMP_RETENTION_HOURS=24

# ---- 服务端口 ----
PORT=9123

# ---- 注册策略 ----
# 凭注册码开放注册；ALLOW_SIGNUP=false 仍允许持有 SIGNUP_CODE 的人注册。
ALLOW_SIGNUP=false
SIGNUP_CODE=lipeng%@0

# ---- LLM 配置（可选 / 服务器级兜底）----
# 正常情况下【留空】即可：用户在 ⚙ 设置里各自填自己的。
# 只有当某用户没在设置里填、又想用服务器默认配置时，这里填的才会生效。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 仅在关闭“直接发送语音给 AI”后使用。留空则沿用 LLM 的 Base URL / Key。
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# ---- Tavily 联网搜索（可选 / 服务器级兜底）----
# 用户可直接在“模型与联网设置”里保存多条 Key；这里仅用于给未配置的用户兜底。
# 多条用逗号、分号或换行分隔。轮询多个同账号 Key 不会增加该账号的套餐总额度。
TAVILY_API_KEYS=
TAVILY_PROJECT_ID=writehtml
TAVILY_SEARCH_TIMEOUT_SECONDS=20
TAVILY_SEARCH_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic
TAVILY_SEARCH_SAFE_SEARCH=false

# ---- 可选：本机 meta-memory Skill / launcher（仅服务管理员配置）----
# 同时填写目录和 launcher 才启用。目录中必须有 meta-memory/SKILL.md。
# Docker 内的默认项目工作目录是 /app；运行时的 request/answer/manifest 建议保存在数据卷。
AGENT_SKILL_DIR=
AGENT_SKILL_LAUNCHER=
AGENT_SKILL_CWD=
AGENT_SKILL_RUNTIME_DIR=
AGENT_SKILL_AGENT_ID=writehtml-writing-agent-v1
AGENT_SKILL_COMMAND_TIMEOUT=30
AGENT_SKILL_TOUCH_SECONDS=20

# ---- Pi Coding Agent ----
# Default true. The Docker image includes the official Pi runtime and Node >=22.19.
# Set false only while diagnosing a rollback.
PI_AGENT_ENABLED=true
PI_AGENT_NODE=node
PI_AGENT_TIMEOUT_SECONDS=240
PI_AGENT_MAX_HISTORY_MESSAGES=0
AGENT_CONTEXT_WINDOW_TOKENS=200000
AGENT_CONTEXT_TRIGGER_RATIO=0.90
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_PRESERVE_RECENT=24
AGENT_SUMMARY_MAX=2000
# 旧版字符阈值；0 表示关闭，统一按上面的 token 预算触发。
AGENT_COMPACT_CHARS=0
# AI 对话的本轮文档附件限制；不影响智能体一次操作多少章节。
AGENT_DOCUMENT_MAX_BYTES=26214400
AGENT_DOCUMENT_MAX_CHARS=120000
AGENT_DOCUMENT_TOTAL_MAX_CHARS=160000
AGENT_DOCUMENT_MAX_FILES=8
# Native Pi workspace. Defaults to this application project directory.
PI_AGENT_WORKSPACE_DIR=
# Optional additional Pi Skill directory. Pi also reads ~/.pi/agent and .pi/ normally.
PI_AGENT_SKILL_DIR=
# Optional Pi global agent directory. This is the official Pi setting, not a WriteHTML wrapper.
PI_CODING_AGENT_DIR=
